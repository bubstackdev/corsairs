@inline(never) public func makeStream(_ queue: consuming any MTLCommandQueue) -> ComputeStream

@inline(never) public func inputBuffer(_ buffer: consuming any MTLBuffer, _ scalar: consuming NDArray.ScalarType, _ shape: [Int]) -> InferenceFunction.AsyncValue

@inline(never) public func outputBuffer(_ buffer: consuming any MTLBuffer, _ scalar: consuming NDArray.ScalarType, _ shape: [Int]) -> InferenceFunction.AsyncMutableValue

@inline(never) public func arrayInput(_ array: consuming NDArray) -> InferenceFunction.AsyncValue

@inline(never) public func arrayOutput(_ array: consuming NDArray) -> InferenceFunction.AsyncMutableValue

@inline(never) public func encode(_ function: borrowing InferenceFunction, _ inputs: [String : InferenceFunction.AsyncValue], _ output: inout InferenceFunction.AsyncMutableValue, _ name: String, _ stream: ComputeStream) throws -> [String : InferenceFunction.AsyncValue]

@inline(never) public func encodeBoth(_ function: borrowing InferenceFunction, _ inputs: [String : InferenceFunction.AsyncValue], _ state: inout InferenceFunction.AsyncMutableValue, _ stateName: String, _ output: inout InferenceFunction.AsyncMutableValue, _ outputName: String, _ stream: ComputeStream) throws -> [String : InferenceFunction.AsyncValue]

@inline(never) public func drain(_ stream: ComputeStream) async

@inline(never) public func readyInput(_ value: InferenceFunction.AsyncValue) async throws -> NDArray?

@inline(never) public func readyOutput(_ value: consuming InferenceFunction.AsyncMutableValue) async throws -> NDArray?

@inline(never) public func emptyInputs() -> [String : InferenceFunction.AsyncValue]

@inline(never) public func insertInput(_ inputs: inout [String : InferenceFunction.AsyncValue], _ value: InferenceFunction.AsyncValue, _ name: String)

@inline(never) public func removeOutput(_ outputs: inout [String : InferenceFunction.AsyncValue], _ name: String) -> InferenceFunction.AsyncValue?

@inline(never) public func dictionaryMetadata<Key, Value>(_ key: Key.Type, _ value: Value.Type) -> any Any.Type where Key : Hashable

@inline(never) public func discardInputs(_ inputs: consuming [String : InferenceFunction.AsyncValue])

@inline(never) public func defaultDevice() -> (any MTLDevice)?

@inline(never) public func commandQueue(_ device: any MTLDevice) -> (any MTLCommandQueue)?

@inline(never) public func sharedBuffer(_ device: any MTLDevice, _ count: Int) -> (any MTLBuffer)?

@inline(never) public func commandBuffer(_ queue: any MTLCommandQueue) -> (any MTLCommandBuffer)?

@inline(never) public func contents(_ buffer: any MTLBuffer) -> UnsafeMutableRawPointer

@inline(never) public func length(_ buffer: any MTLBuffer) -> Int

@inline(never) public func commitAndWait(_ command: any MTLCommandBuffer)

